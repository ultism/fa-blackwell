# Cloned third-party repos
/tmp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# Virtual envs
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# ncu profiler reports are large binaries; regenerate via prof/*.sh harnesses.
*.ncu-rep

# Build artifacts: compiled CUDA executables are built in-place next to their .cu
# sources in bench/ and tests/. Ignore everything in those dirs, then re-include
# only the source files (and let git recurse into subdirs like csrc/, cutlass_ex/).
*.log
/bench/**
/tests/**
!/bench/**/
!/tests/**/
!/bench/**/*.cu
!/bench/**/*.cuh
!/bench/**/*.py
!/bench/**/*.sh
!/bench/**/*.md
!/tests/**/*.cu
!/tests/**/*.cuh
!/tests/**/*.py
!/tests/**/*.sh
!/tests/**/*.md
